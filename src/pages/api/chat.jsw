// backend/chat.jsw
import { secrets } from 'wix-secrets-backend';

export async function chat({ userMessage }) {
  if (!userMessage) {
    return { message: 'Асуулт хоосон байна.' };
  }

  const apiKey = await secrets.getSecret("GROQ_API_KEY");
  if (!apiKey) {
    return { message: 'API түлхүүр олдсонгүй.' };
  }

  try {
    const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${apiKey}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model: "llama-3.3-70b-versatile",
        messages: [
          { role: "system", content: "You are NegOne AI..." },
          { role: "user", content: userMessage }
        ],
        temperature: 0.7,
        max_tokens: 500
      })
    });
    const data = await res.json();
    return { message: data.choices?.[0]?.message?.content || 'Хариулт алга.' };
  } catch (err) {
    console.error(err);
    return { message: 'Алдаа гарлаа.' };
  }
}
