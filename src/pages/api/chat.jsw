import { secrets } from 'wix-secrets-backend';

const SYSTEM_PROMPT = `You are NegOne AI, a supportive and empathetic health and wellness assistant for women. 
Your characteristics:
- Empathetic, encouraging, and informative tone
- Supportive and empowering
- Knowledgeable about fitness, nutrition, mental health, and wellness
- Always respond in Mongolian language
- Provide practical, actionable advice
- Be warm and friendly
- Focus on women's health and wellness
- Encourage self-love and body positivity`;

export async function chat(userMessage) {
  if (!userMessage || typeof userMessage !== 'string') {
    return { message: 'Асуулт хоосон байна.' };
  }

  const apiKey = await secrets.getSecret("GROQ_API_KEY");
  if (!apiKey) {
    return { message: 'API түлхүүр олдсонгүй.' };
  }

  try {
    const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${apiKey}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model: "llama-3.3-70b-versatile",
        messages: [
          { role: "system", content: SYSTEM_PROMPT },
          { role: "user", content: userMessage }
        ],
        temperature: 0.7,
        max_tokens: 500
      })
    });
    
    if (!res.ok) {
      const errorData = await res.json();
      console.error('Groq API error:', errorData);
      return { message: 'Уучлаарай, хариулт авахад алдаа гарлаа.' };
    }
    
    const data = await res.json();
    return { message: data.choices?.[0]?.message?.content || 'Хариулт авахад алдаа гарлаа.' };
  } catch (err) {
    console.error('Chat error:', err);
    return { message: 'Уучлаарай, сүлжээний алдаа гарлаа.' };
  }
}
